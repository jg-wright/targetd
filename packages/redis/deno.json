{
  "name": "@targetd/redis",
  "description": "Load, save and watch @targetd/api rules from Redis with pub/sub hot-reloading via keyspace notifications.",
  "version": "1.0.1",
  "exports": "./src/index.ts",
  "imports": {
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.52.0",
    "@targetd/api": "jsr:@targetd/api@^10.1.0",
    "redis": "npm:redis@^6.2.1",
    "zod": "npm:zod@~4.5.2"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-unversioned-import"
      ]
    }
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "tasks": {
    "pwd": "echo $(pwd)",
    "test": "deno test --allow-all --trace-leaks"
  },
  "publish": {
    "include": [
      "deno.json",
      "src/",
      "LICENSE",
      "README.md"
    ]
  }
}
